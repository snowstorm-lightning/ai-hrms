# Copy this file to infra/.env before running Docker Compose.
# Keep infra/.env out of git; it contains real deployment secrets.

DOCKER_BIND_IP=127.0.0.1

API_PORT=8020
WEB_PORT=8021

# Only used with infra/compose.dev.yaml when native tools need host access.
POSTGRES_PORT=55432
AGENT_PORT=8090

# Generate URL-safe hex values:
#   openssl rand -hex 24  # POSTGRES_PASSWORD
#   openssl rand -hex 32  # JWT_SECRET
POSTGRES_PASSWORD=
# Example: postgres://ai_hrms:<same POSTGRES_PASSWORD>@postgres:5432/ai_hrms?sslmode=disable
DOCKER_DATABASE_URL=
JWT_SECRET=
AI_HRMS_ENV=production
AI_HRMS_ENABLE_DEMO_SEED=false

VITE_API_BASE_URL=/api
VITE_DEMO_MODE=false
DOCKER_CORS_ALLOWED_ORIGINS=https://hrms.snowstormlightning.top

DOCKER_AI_HRMS_INGEST_ROOT=
AI_HRMS_ENABLE_AGENT_URL_CONNECTOR=false

# AI provider configuration. Keep API keys only in infra/.env, never in git.
# DeepSeek uses an OpenAI-compatible Chat Completions API.
AGENT_BASE_URL=http://agent:8090
AGENT_TIMEOUT_SECONDS=30
# Required when AI_CHAT_PROVIDER or AI_EMBEDDING_PROVIDER is not "fake".
# Generate with: openssl rand -hex 32
AI_HRMS_AGENT_SERVICE_TOKEN=
AI_CHAT_PROVIDER=fake
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_TIMEOUT_SECONDS=30

# RAG embedding provider. Configure a compatible embedding service when
# replacing deterministic demo embeddings.
AI_EMBEDDING_PROVIDER=fake
OPENAI_COMPATIBLE_EMBEDDING_API_KEY=
OPENAI_COMPATIBLE_EMBEDDING_BASE_URL=
OPENAI_COMPATIBLE_EMBEDDING_MODEL=
# Demo fake embeddings use 8 dimensions. Real providers must use the model's
# actual embedding dimension before ingesting documents into pgvector.
RAG_EMBEDDING_DIMENSIONS=8
