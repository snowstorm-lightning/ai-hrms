# Copy this file to infra/.env before running Docker Compose.
# Keep infra/.env out of git; it contains real deployment secrets.

DOCKER_BIND_IP=127.0.0.1

API_PORT=8020
WEB_PORT=8021

# Production image settings used by infra/compose.prod.yaml.
# GitHub Actions pushes these application images to your private registry.
# Example registry host: registry.example.com
IMAGE_REGISTRY=
IMAGE_NAMESPACE=
IMAGE_TAG=latest

# Strongly recommended for production: mirror these public runtime images to a
# private registry and set the full image names here so production servers do
# not depend on Docker Hub or GHCR during deploy.
AI_HRMS_POSTGRES_IMAGE=pgvector/pgvector:pg17
AI_HRMS_EMBEDDING_IMAGE=ghcr.io/ggml-org/llama.cpp:server

# Keep false for normal deploys. Set true only after AI_HRMS_EMBEDDING_IMAGE is
# mirrored to a registry the server can pull and the embedding variables below
# are configured.
AI_HRMS_ENABLE_EMBEDDING=false

# Only used with infra/compose.dev.yaml when native tools need host access.
POSTGRES_PORT=55432
AGENT_PORT=8090
EMBEDDING_PORT=8082

# Generate URL-safe hex values:
#   openssl rand -hex 24  # POSTGRES_PASSWORD
#   openssl rand -hex 32  # JWT_SECRET
POSTGRES_PASSWORD=
# Example: postgres://ai_hrms:<same POSTGRES_PASSWORD>@postgres:5432/ai_hrms?sslmode=disable
DOCKER_DATABASE_URL=
JWT_SECRET=
AI_HRMS_ENV=production
AI_HRMS_ENABLE_DEMO_SEED=false

VITE_API_BASE_URL=/api
VITE_DEMO_MODE=false
DOCKER_CORS_ALLOWED_ORIGINS=https://hrms.snowstormlightning.top

DOCKER_AI_HRMS_INGEST_ROOT=
AI_HRMS_ENABLE_AGENT_URL_CONNECTOR=false

# AI provider configuration. Keep API keys only in infra/.env, never in git.
# DeepSeek uses an OpenAI-compatible Chat Completions API.
AGENT_BASE_URL=http://agent:8090
AGENT_TIMEOUT_SECONDS=30
# Required when AI_CHAT_PROVIDER or AI_EMBEDDING_PROVIDER is not "fake".
# Generate with: openssl rand -hex 32
AI_HRMS_AGENT_SERVICE_TOKEN=
AI_CHAT_PROVIDER=fake
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_TIMEOUT_SECONDS=30

# RAG embedding provider. Configure a compatible embedding service when
# replacing deterministic demo embeddings.
#
# Recommended local CPU setup for a 4C/4GB server:
#   AI_HRMS_ENABLE_EMBEDDING=true ./infra/deploy.sh
#   AI_EMBEDDING_PROVIDER=local-openai-compatible
#   OPENAI_COMPATIBLE_EMBEDDING_API_KEY=<same-as-LOCAL_EMBEDDING_API_KEY>
#   OPENAI_COMPATIBLE_EMBEDDING_BASE_URL=http://embedding:80/v1
#   OPENAI_COMPATIBLE_EMBEDDING_MODEL=Qwen3-Embedding-0.6B-Q8_0
#   RAG_EMBEDDING_DIMENSIONS=1024
AI_EMBEDDING_PROVIDER=fake
OPENAI_COMPATIBLE_EMBEDDING_API_KEY=
OPENAI_COMPATIBLE_EMBEDDING_BASE_URL=
OPENAI_COMPATIBLE_EMBEDDING_MODEL=
# Demo fake embeddings use 8 dimensions. Real providers must use the model's
# actual embedding dimension before ingesting documents into pgvector.
RAG_EMBEDDING_DIMENSIONS=8

# Optional local llama.cpp OpenAI-compatible embedding service. This does not
# replace DeepSeek chat; it only serves RAG vectors. Keep the service bound to
# DOCKER_BIND_IP unless you add real network access controls.
LOCAL_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B-GGUF:Q8_0
LOCAL_EMBEDDING_API_KEY=local-no-auth
LOCAL_EMBEDDING_CTX_SIZE=2048
LOCAL_EMBEDDING_THREADS=2
LOCAL_EMBEDDING_PARALLEL=1
LOCAL_EMBEDDING_UBATCH_SIZE=512
LOCAL_EMBEDDING_CACHE_RAM=0
LOCAL_EMBEDDING_MEMORY_LIMIT=2g
