DATABASE_URL=postgres://ai_hrms:ai_hrms@localhost:55432/ai_hrms?sslmode=disable
AI_HRMS_ENV=development
AI_HRMS_ENABLE_DEMO_SEED=true
JWT_SECRET=dev-secret-change-me
API_PORT=8080
VITE_API_BASE_URL=http://localhost:8080/api
VITE_DEMO_MODE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AI_HRMS_INGEST_ROOT=
AI_HRMS_ENABLE_AGENT_URL_CONNECTOR=false

# AI provider configuration. Leave the key empty to keep deterministic fake mode.
# DeepSeek uses an OpenAI-compatible Chat Completions API.
AGENT_BASE_URL=http://127.0.0.1:8090
AGENT_TIMEOUT_SECONDS=30
# Required when AI_CHAT_PROVIDER or AI_EMBEDDING_PROVIDER is not "fake".
# Generate with: openssl rand -hex 32
AI_HRMS_AGENT_SERVICE_TOKEN=
AI_CHAT_PROVIDER=fake
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_TIMEOUT_SECONDS=30

# RAG embedding provider. DeepSeek chat API does not replace pgvector storage;
# configure an OpenAI-compatible embedding provider here when available.
#
# Local CPU embedding recommendation for 4C/4GB:
#   AI_EMBEDDING_PROVIDER=local-openai-compatible
#   OPENAI_COMPATIBLE_EMBEDDING_API_KEY=local-no-auth
#   OPENAI_COMPATIBLE_EMBEDDING_BASE_URL=http://127.0.0.1:8082/v1
#   OPENAI_COMPATIBLE_EMBEDDING_MODEL=Qwen3-Embedding-0.6B-Q8_0
#   RAG_EMBEDDING_DIMENSIONS=1024
AI_EMBEDDING_PROVIDER=fake
OPENAI_COMPATIBLE_EMBEDDING_API_KEY=
OPENAI_COMPATIBLE_EMBEDDING_BASE_URL=
OPENAI_COMPATIBLE_EMBEDDING_MODEL=
# Demo fake embeddings use 8 dimensions. Real providers must use the model's
# actual embedding dimension before ingesting documents into pgvector.
RAG_EMBEDDING_DIMENSIONS=8
